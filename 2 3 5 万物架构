    // 核心推演：注入指数变动
    void evolve(int level, int deltaA, int deltaB, int deltaC) {
        if (level < 0 || level >= (int)layers.size()) return;

        CosmicLayer &layer = layers[level];
        layer.a += deltaA;
        layer.b += deltaB;
        layer.c += deltaC;

        // 检查是否踏入一元大数圆满
