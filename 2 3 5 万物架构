// ==========================================
// 1. 基础数学：纯整数幂运算（零浮点）
// ==========================================
long long int_pow(int base, int exp) {
    long long result = 1;
    for (int i = 0; i < exp; ++i) result *= base;
    return result;
}

long long factorial(int n) {
    long long res = 1;
    for (int i = 1; i <= n; ++i) res *= i;
    return res;
}

// ==========================================
// 2. 核心宇宙层级：次方位状态
// ==========================================
struct CosmicLayer {
    int a; // 基底0指数 (对应 2, 7, 3)
    int b; // 基底1指数 (对应 3, 9, 6)
    int c; // 基底2指数 (对应 5, 1, 8)

    CosmicLayer() : a(0), b(0), c(0) {}

    long long getValue(int p1, int p2, int p3) const {
        return int_pow(p1, a) * int_pow(p2, b) * int_pow(p3, c);
    }

    // 任何纪元的一元大圆满都是：指数 (6, 4, 2)
    bool isComplete() const {
        return (a == 6 && b == 4 && c == 2);
    }

    void reset() { a = 0; b = 0; c = 0; }
};

