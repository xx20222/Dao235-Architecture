                 << prime[0] << "^" << layer.a << " x "
                 << prime[1] << "^" << layer.b << " x "
                 << prime[2] << "^" << layer.c << " = " << val
                 << " (129600)" << endl;

            layer.reset(); // 当前位清零（有归于无）
            advanceEra();  // 纪元进化
        }
    }

